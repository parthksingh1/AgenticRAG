# ─────────────────────────────────────────────────────────────────────────────
# AgenticRAG — example environment. Copy to `.env` and fill in.
# NEVER commit a real .env. All config is read via pydantic-settings.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
AGRAG_APP_ENV=local                     # local | ci | staging | production
AGRAG_LOG_LEVEL=INFO
AGRAG_API_HOST=0.0.0.0
AGRAG_API_PORT=8000
# 32+ char random string: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
AGRAG_SECRET_KEY=change-me-please-generate-a-long-random-value-000000

# ── Postgres (pgvector) ─────────────────────────────────────────────────────
AGRAG_POSTGRES_USER=agrag
AGRAG_POSTGRES_PASSWORD=agrag
AGRAG_POSTGRES_DB=agrag
AGRAG_DATABASE_URL=postgresql+asyncpg://agrag:agrag@postgres:5432/agrag
AGRAG_DATABASE_URL_SYNC=postgresql+psycopg://agrag:agrag@postgres:5432/agrag

# ── Redis ───────────────────────────────────────────────────────────────────
AGRAG_REDIS_URL=redis://redis:6379/0
AGRAG_CELERY_BROKER_URL=redis://redis:6379/1
AGRAG_CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── OpenSearch ──────────────────────────────────────────────────────────────
AGRAG_OPENSEARCH_URL=http://opensearch:9200
AGRAG_OPENSEARCH_USER=
AGRAG_OPENSEARCH_PASSWORD=

# ── MinIO (S3) ──────────────────────────────────────────────────────────────
AGRAG_MINIO_ENDPOINT=minio:9000
AGRAG_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
AGRAG_MINIO_ACCESS_KEY=minioadmin
AGRAG_MINIO_SECRET_KEY=minioadmin
AGRAG_MINIO_BUCKET=agrag-documents
AGRAG_MINIO_BACKUP_BUCKET=agrag-backups
AGRAG_MINIO_SECURE=false

# ── Neo4j ───────────────────────────────────────────────────────────────────
AGRAG_NEO4J_URI=bolt://neo4j:7687
AGRAG_NEO4J_USER=neo4j
AGRAG_NEO4J_PASSWORD=agrag-neo4j-password

# ── LLM providers (leave blank to disable that provider) ────────────────────
AGRAG_OPENAI_API_KEY=
AGRAG_ANTHROPIC_API_KEY=
AGRAG_GOOGLE_API_KEY=
AGRAG_GROQ_API_KEY=
AGRAG_TOGETHER_API_KEY=
AGRAG_COHERE_API_KEY=
AGRAG_TAVILY_API_KEY=

# Default routing policy
AGRAG_DEFAULT_CHAT_MODEL=claude-sonnet-5
AGRAG_DEFAULT_CHEAP_MODEL=claude-haiku-4-5-20251001
AGRAG_DEFAULT_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
AGRAG_DEFAULT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
AGRAG_CLERK_SECRET_KEY=
AGRAG_CLERK_PUBLISHABLE_KEY=
AGRAG_CLERK_JWKS_URL=
AGRAG_CLERK_ISSUER=
# Local dev escape hatch: when true, a dev header can stand in for Clerk JWTs.
AGRAG_AUTH_DEV_MODE=true

# ── Observability ───────────────────────────────────────────────────────────
AGRAG_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
AGRAG_OTEL_SERVICE_NAME=agrag-api
AGRAG_OTEL_TRACES_ENABLED=true
AGRAG_LANGFUSE_HOST=http://langfuse:3000
AGRAG_LANGFUSE_PUBLIC_KEY=
AGRAG_LANGFUSE_SECRET_KEY=

# ── Frontend ────────────────────────────────────────────────────────────────
AGRAG_NEXT_PUBLIC_API_URL=http://localhost:8000
AGRAG_NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Budgets & limits (defaults; overridable per tenant in DB) ───────────────
AGRAG_DEFAULT_TENANT_DAILY_TOKEN_BUDGET=2000000
AGRAG_MAX_TOKENS_PER_REQUEST=16000
AGRAG_MAX_TOOL_CALLS_PER_TURN=8
AGRAG_MAX_AGENT_ITERATIONS=12
AGRAG_RATE_LIMIT_CHAT_PER_MINUTE=30

# ── host ports ────────────────────────────────────────────────────────────────
# Override any of these when a port is already taken on your machine. Most
# developers already have Postgres on 5432 or Grafana on 3000, and "port is
# already allocated" is a poor first impression for a `docker compose up`
# quickstart.
#
#   AGRAG_PORT_POSTGRES=55432 docker compose up
#
AGRAG_PORT_POSTGRES=5432
AGRAG_PORT_REDIS=6379
AGRAG_PORT_OPENSEARCH=9200
AGRAG_PORT_MINIO=9000
AGRAG_PORT_MINIO_CONSOLE=9001
AGRAG_PORT_NEO4J_HTTP=7474
AGRAG_PORT_NEO4J_BOLT=7687
AGRAG_PORT_API=8000
AGRAG_PORT_WEB=3000
AGRAG_PORT_JAEGER=16686
AGRAG_PORT_PROMETHEUS=9090
AGRAG_PORT_ALERTMANAGER=9093
AGRAG_PORT_GRAFANA=3001
AGRAG_PORT_LANGFUSE=3002
